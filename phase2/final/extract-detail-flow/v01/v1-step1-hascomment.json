      { "from": "UE_5GMM_DEREGISTERED", "to": "Access_Barring_Detected", "type": "trigger" },
      { "from": "Access_Barring_Detected", "to": "UE_5GMM_DEREGISTERED", "type": "condition", "label": "Registration blocked" },

      { "from": "UE_5GMM_REGISTERED_INITIATED", "to": "UE_Trigger_DeRegistration", "type": "trigger" },
      { "from": "UE_Trigger_DeRegistration", "to": "UE_5GMM_DEREGISTERED", "type": "condition", "label": "Abort registration, perform de-reg" },

      { "from": "UE_5GMM_REGISTERED_INITIATED", "to": "UE_Receives_Deregistration_Request", "type": "trigger" },
      { "from": "UE_Receives_Deregistration_Request", "to": "UE_5GMM_REGISTERED_INITIATED", "type": "condition", "label": "Abort de-reg, continue registration" },

      { "from": "AMF_Processing_Reg_Request", "to": "AMF_Sends_REGISTRATION_REJECT", "type": "trigger", "label": "Protocol Error (#96, #99, #100, #111)" },

      { "from": "AMF_5GMM_REGISTERED", "to": "AMF_Receives_REGISTRATION_REQUEST", "type": "trigger", "label": "REG REQ (Initial) received" },
      { "from": "AMF_Receives_REGISTRATION_REQUEST", "to": "AMF_Processing_Reg_Request", "type": "condition", "label": "Delete old context, process new" },

      { "from": "AMF_5GMM_COMMON_PROCEDURE_INITIATED", "to": "AMF_Receives_Deregistration_Request", "type": "trigger" },
      { "from": "AMF_Receives_Deregistration_Request", "to": "AMF_Idle", "type": "condition", "label": "Abort initial reg, process de-reg" }
    ]
  }
}