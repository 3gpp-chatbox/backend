{
  "nodes": [
    {
      "id": "UE_5GMM_DEREGISTERED",
      "type": "state",
      "properties": {
        "description": "Initial state before registration or after certain failures."
      }
    },
    {
      "id": "UE_5GMM_REGISTERED_INITIATED",
      "type": "state",
      "properties": {
        "description": "UE has sent REGISTRATION REQUEST and is waiting for a response."
      }
    },
    {
      "id": "UE_5GMM_REGISTERED",
      "type": "state",
      "properties": {
        "description": "UE is successfully registered with the network."
      }
    },
    {
      "id": "UE_5GMM_DEREGISTERED_ATTEMPTING_REGISTRATION",
      "type": "state",
      "properties": {
        "description": "Registration failed, UE is waiting for timer T3511 or T3346 to expire before retrying."
      }
    },
    {
      "id": "UE_5GMM_DEREGISTERED_LIMITED_SERVICE",
      "type": "state",
      "properties": {
        "description": "Registration failed, normal service not possible in current area/PLMN (e.g., TAI not allowed, CAG issues)."
      }
    },
    {
      "id": "UE_5GMM_DEREGISTERED_PLMN_SEARCH",
      "type": "state",
      "properties": {
        "description": "Registration failed, UE needs to perform PLMN/SNPN selection."
      }
    },
    {
      "id": "UE_5GMM_DEREGISTERED_NO_SUPI",
      "type": "state",
      "properties": {
        "description": "Registration rejected due to illegal UE/ME or 5GS not allowed; USIM/SNPN entry considered invalid."
      }
    },
    {
      "id": "UE_5GMM_DEREGISTERED_NO_CELL_AVAILABLE",
      "type": "state",
      "properties": {
        "description": "Registration rejected with redirection to EPC required."
      }
    },
    {
      "id": "UE_Needs_Mobility_Update",
      "type": "state",
      "properties": {
        "description": "Initial registration aborted due to TAI change after ACCEPT; Mobility Registration Update procedure required."
      }
    },
    {
      "id": "Event_Trigger_Initial_Registration",
      "type": "event",
      "properties": {
        "description": "Internal UE decision or upper layer request to start initial registration."
      }
    },
    {
      "id": "Event_REGISTRATION_ACCEPT_Received",
      "type": "event",
      "properties": {
        "message_type": "REGISTRATION ACCEPT",
        "description": "Network accepts the initial registration request."
      }
    },
    {
      "id": "Event_REGISTRATION_REJECT_Received",
      "type": "event",
      "properties": {
        "message_type": "REGISTRATION REJECT",
        "description": "Network rejects the initial registration request."
      },
      "parameters": ["5GMM cause", "T3346 value", "Rejected NSSAI", "Extended rejected NSSAI", "CAG information list", "Extended CAG information list", "Forbidden TAI(s)", "N3IWF identifier", "TNAN information", "RAT utilization control"]
    },
    {
      "id": "Event_T3510_Timeout",
      "type": "event",
      "properties": {
        "timer": "T3510",
        "description": "Timer T3510 expired while waiting for REGISTRATION ACCEPT/REJECT."
      }
    },
    {
      "id": "Event_T3511_Timeout",
      "type": "event",
      "properties": {
        "timer": "T3511",
        "description": "Timer T3511 expired, UE should retry registration."
      }
    },
    {
      "id": "Event_T3502_Timeout",
      "type": "event",
      "properties": {
        "timer": "T3502",
        "description": "Timer T3502 expired after maximum registration attempts."
      }
    },
    {
      "id": "Event_LowerLayer_Failure",
      "type": "event",
      "properties": {
        "description": "Lower layers indicated failure or released the NAS signalling connection."
      }
    },
    {
      "id": "Event_TAI_Change",
      "type": "event",
      "properties": {
        "description": "The current Tracking Area Identity (TAI) has changed."
      }
    },
    {
      "id": "Event_Transmission_Failure_REG_COMPLETE",
      "type": "event",
      "properties": {
        "message_type": "REGISTRATION COMPLETE",
        "description": "Lower layers indicated transmission failure for REGISTRATION COMPLETE."
      }
    }
  ],
