  "events": [
    {
      "event_name": "Initial_Registration_Initiation_Trigger",
      "trigger": "UE performs initial registration for 5GS services, emergency services, SMS over NAS, moves from GERAN/UTRAN to NG-RAN, performs initial registration for onboarding services in SNPN, disaster roaming services, or to come out of unavailability period."
    },
    {
      "event_name": "REGISTRATION_REQUEST_Received",
      "trigger": "AMF receives REGISTRATION REQUEST message from UE."
    },
    {
      "event_name": "REGISTRATION_ACCEPT_Received",
      "trigger": "UE receives REGISTRATION ACCEPT message from AMF."
    },
    {
      "event_name": "REGISTRATION_REJECT_Received",
      "trigger": "UE receives REGISTRATION REJECT message from AMF."
    },
    {
      "event_name": "REGISTRATION_COMPLETE_Received",
      "trigger": "AMF receives REGISTRATION COMPLETE message from UE (when expected)."
    },
    {
      "event_name": "T3510_Timeout",
      "trigger": "Timer T3510 expires in the UE."
    },
    {
      "event_name": "T3550_Timeout",
      "trigger": "Timer T3550 expires in the AMF."
    },
    {
      "event_name": "T3511_Expiry",
      "trigger": "Timer T3511 expires in the UE after a registration failure."
    },
    {
      "event_name": "T3502_Expiry",
      "trigger": "Timer T3502 expires in the UE after registration attempt counter reaches 5."
    },
    {
      "event_name": "T3346_Expiry",
      "trigger": "Timer T3346 expires in the UE."
    },
    {
      "event_name": "T3447_Expiry",
      "trigger": "Timer T3447 expires in the UE."
    },
    {
      "event_name": "T3526_Expiry",
      "trigger": "Timer T3526 associated with an S-NSSAI expires in the UE."
    },
    {
      "event_name": "Lower_Layer_Failure_UE",
      "trigger": "Lower layer failure occurs in the UE before REGISTRATION ACCEPT or REGISTRATION REJECT is received."
    },
    {
      "event_name": "Lower_Layer_Failure_AMF",
      "trigger": "Lower layer failure occurs at the network side before REGISTRATION COMPLETE message has been received from the UE and timer T3550 is running."
    },
    {
      "event_name": "NAS_Signalling_Connection_Release_UE",
      "trigger": "Release of the NAS signalling connection received from lower layers before REGISTRATION ACCEPT or REGISTRATION REJECT message is received."
    },
    {
      "event_name": "Access_Attempt_Barred",
      "trigger": "Lower layers indicate that the access attempt is barred."
    },
    {
      "event_name": "Access_Barring_Alleviated",
      "trigger": "Lower layers indicate that access barring is alleviated for the relevant access category."
    },
    {
      "event_name": "UE_Initiated_De-registration_Required",
      "trigger": "UE needs to perform de-registration (e.g., due to USIM removal)."
    },
    {
      "event_name": "De-registration_Procedure_Collision",
      "trigger": "UE receives a DEREGISTRATION REQUEST message from the network while in state 5GMM-REGISTERED-INITIATED."
    },
    {
      "event_name": "Current_TAI_Change",
      "trigger": "The current TAI changes before the registration procedure for initial registration is completed."
    },
    {
      "event_name": "Tracking_Area_Border_Crossed_After_Accept",
      "trigger": "A tracking area border is crossed when the REGISTRATION ACCEPT message has been received but before a REGISTRATION COMPLETE message is sent."
    },
    {
      "event_name": "Transmission_Failure_REGISTRATION_COMPLETE",
      "trigger": "Transmission failure indication for REGISTRATION COMPLETE message received from lower layers."
    },
    {
      "event_name": "Transmission_Failure_REGISTRATION_REQUEST",
      "trigger": "Transmission failure indication for REGISTRATION REQUEST message received from lower layers."
    },
    {
      "event_name": "Protocol_Error_In_REGISTRATION_REQUEST",
      "trigger": "AMF receives REGISTRATION REQUEST message with a protocol error."
    },
    {
      "event_name": "Duplicate_REGISTRATION_REQUEST_Received_After_Accept",
      "trigger": "AMF receives another REGISTRATION REQUEST message after REGISTRATION ACCEPT has been sent and before REGISTRATION COMPLETE is received (if expected)."
    },
    {
      "event_name": "Duplicate_REGISTRATION_REQUEST_Received_Before_Accept",
      "trigger": "AMF receives more than one REGISTRATION REQUEST message before sending REGISTRATION ACCEPT or REGISTRATION REJECT."
    },
    {
      "event_name": "REGISTRATION_REQUEST_Received_In_Registered_State",
      "trigger": "AMF receives a REGISTRATION REQUEST message with 5GS registration type IE set to 'initial registration' while in state 5GMM-REGISTERED."
    },
    {
      "event_name": "Mobility_Periodic_REGISTRATION_REQUEST_Received_Before_Complete",
      "trigger": "AMF receives a REGISTRATION REQUEST message with 5GS registration type IE set to 'mobility registration updating' or 'periodic registration updating' before REGISTRATION COMPLETE message is received (if expected)."
    },
    {
      "event_name": "DEREGISTRATION_REQUEST_Received_Before_Complete",
      "trigger": "AMF receives a DEREGISTRATION REQUEST message before REGISTRATION COMPLETE message is received (if expected)."
    },
    {
      "event_name": "Invalid_UE_Security_Capabilities_Received",
      "trigger": "AMF receives REGISTRATION REQUEST message with invalid or unacceptable UE security capabilities."
    },
    {
      "event_name": "Access_For_Localized_Services_No_Longer_Allowed",
      "trigger": "Access for localized services in the current SNPN is disabled or validity information is no longer met while initial registration is ongoing."
    },
    {
      "event_name": "Network_Slicing_Subscription_Change_Indicated",
      "trigger": "UDM indicates to AMF that the subscription data for network slicing has changed."
    },
    {
      "event_name": "SOR_Container_Integrity_Check_Failure",
      "trigger": "The SOR transparent container IE included in the REGISTRATION ACCEPT message does not successfully pass the integrity check."
    },
    {
      "event_name": "SOR_Container_Integrity_Check_Success",
      "trigger": "The SOR transparent container IE included in the REGISTRATION ACCEPT message successfully passes the integrity check."
    }
  ],
