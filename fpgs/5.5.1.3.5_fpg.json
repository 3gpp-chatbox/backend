{
  "procedure_name": "Mobility and Periodic Registration Update - Registration Reject",
  "description": "UE behavior upon receiving a REGISTRATION REJECT message during mobility and periodic registration update.",
  "nodes": [
    {
      "id": "AMF_Sends_Registration_Reject",
      "type": "action",
      "properties": {
        "message_type": "REGISTRATION REJECT"
      },
      "parameters": [
        "5GMM Cause Value",
        "T3346 (Back-off Timer)",
        "Rejected NSSAI",
        "CAG Information",
        "TNAN Information"
      ]
    },
    {
      "id": "UE_Receives_Registration_Reject",
      "type": "event",
      "properties": {
        "message_type": "REGISTRATION REJECT"
      },
      "parameters": [
        "5GMM Cause Value"
      ]
    },
    {
      "id": "UE_Actions_Based_on_5GMM_Cause",
      "type": "action",
      "properties": {},
      "parameters": [
        "5GMM Cause Value"
      ]
    },
    {
      "id": "5GS_Update_Status_Set",
      "type": "state",
      "properties": {
        "description": "UE sets the 5GS update status based on the 5GMM cause."
      }
    },
    {
      "id": "Stored_Parameters_Deleted",
      "type": "action",
      "properties": {
        "parameters_deleted": ["5G-GUTI", "TAI Lists", "ngKSI"]
      }
    },
    {
      "id": "PLMN_SNPN_Forbidden_Lists_Updated",
      "type": "action",
      "properties": {
        "lists_updated": ["Forbidden PLMNs", "Forbidden SNPNs"]
      }
    },
    {
      "id": "Timers_Started_Stopped",
      "type": "action",
      "properties": {
        "timers": ["T3346", "T3245", "T3526"]
      }
    },
    {
      "id": "5GMM_State_Transition",
      "type": "state",
      "properties": {
        "possible_states": ["5GMM-DEREGISTERED", "5GMM-REGISTERED.LIMITED-SERVICE"]
      }
    },
    {
      "id": "PLMN_SNPN_Selection",
      "type": "action",
      "properties": {}
    },
    {
      "id": "EMM_Parameters_Handled",
      "type": "action",
      "properties": {
        "mode": "Single-Registration"
      }
    },
    {
      "id": "N1_Mode_Capability_Disabled",
      "type": "action",
      "properties": {}
    },
     {
      "id": "CAG_Information_Stored",
      "type": "action",
      "properties": {}
    },
    {
      "id": "Cell_Reselection_Attempt",
      "type": "action",
      "properties": {}
    },
    {
      "id": "EUTRA_Cell_Selection_Attempt",
      "type": "action",
      "properties": {}
    },
    {
      "id": "NSSAI_Backoff_Handling",
      "type": "action",
      "properties": {}
    },

    {
      "id": "IE_Handling",
      "type": "action",
      "properties": {
        "information_elements": [
          "RAT utilization control IE",
          "Extended 5GMM cause IE",
          "CAG information list IE",
          "Extended CAG information list IE",
          "Forbidden TAI(s) for 5GS forbidden tracking areas for roaming IE",
          "Forbidden TAI(s) for 5GS forbidden tracking areas for regional provision of service IE",
          "Disaster return wait range IE",
          "N3IWF identifier IE",
          "TNAN information IE"
        ]
      }
    },

     {
      "id": "Abnormal_Case_Check",
      "type": "condition",
      "properties": {
        "condition": "5GMM cause value is abnormal OR expected information element is missing."
      }
    },
    {
      "id": "Abnormal_Case_Procedure",
      "type": "action",
      "properties": {
        "reference": "Subclause 5.5.1.3.7"
      }
    }
  ],
  "edges": [
    {
      "from": "AMF_Sends_Registration_Reject",
      "to": "UE_Receives_Registration_Reject",
      "action": "Send REGISTRATION REJECT",
      "properties": {}
    },
    {
      "from": "UE_Receives_Registration_Reject",
      "to": "UE_Actions_Based_on_5GMM_Cause",
