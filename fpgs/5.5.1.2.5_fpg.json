    {
      "from": "Single_Registration_Mode",
      "to": "End_Procedure",
      "properties": {}
    },
    {
      "from": "General_Actions",
      "to": "End_Procedure",
      "properties": {},
      "condition": "No SNPN specific actions"
    },

    {
      "from": "Evaluate_5GMM_Cause",
      "to": "General_Actions",
      "condition": "no specific cause triggered",
      "properties": {}
    },
      {
      "from": "Integrity_Protected_Yes",
      "to": "General_Actions",
      "properties": {},
      "condition": "evaluateCauseValue is false"
    },
       {
      "from": "Integrity_Protected_No",
