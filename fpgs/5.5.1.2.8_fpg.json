{
  "procedure_name": "AMF Handling of Abnormal Events During Initial Registration",
  "description": "Procedure detailing how the AMF handles various error and unexpected scenarios during the initial registration process as per 3GPP NAS specification section 5.5.1.2.8.",
  "nodes": [
    {
      "id": "InitialRegistrationStarted",
      "type": "state",
      "properties": {
        "description": "Initial registration procedure has begun."
      }
    },
    {
      "id": "LowerLayerFailure",
      "type": "event",
      "properties": {
        "description": "Lower layer failure occurs before REGISTRATION COMPLETE and while T3550 is running."
      }
    },
    {
      "id": "RegistrationAbortedLowerLayer",
      "type": "action",
      "properties": {
        "description": "AMF aborts the initial registration procedure locally."
      }
    },
    {
      "id": "5GMM_REGISTERED",
      "type": "state",
      "properties": {
        "description": "AMF enters 5GMM-REGISTERED state."
      }
    },
    {
      "id": "GUTIConsideration",
      "type": "action",
      "properties": {
        "description": "AMF considers old and new 5G-GUTIs valid for a period (if a new one was assigned)."
      }
    },
    {
      "id": "ProtocolError",
      "type": "event",
      "properties": {
        "description": "Protocol error detected in REGISTRATION REQUEST."
      }
    },
    {
      "id": "SendRegistrationReject",
      "type": "action",
      "properties": {
        "description": "AMF sends REGISTRATION REJECT with appropriate cause value."
      }
    },
    {
      "id": "T3550Expiry",
      "type": "event",
      "properties": {
        "description": "Timer T3550 has expired."
      }
    },
    {
      "id": "RetransmitRegistrationAccept",
      "type": "action",
      "properties": {
        "description": "AMF retransmits REGISTRATION ACCEPT and restarts T3550."
      }
    },
    {
      "id": "T3550ExpiryLimitReached",
      "type": "event",
      "properties": {
        "description": "Timer T3550 has expired for the fifth time."
      }
    },
    {
      "id": "RedundantRegistrationRequest",
      "type": "event",
      "properties": {
        "description": "Redundant REGISTRATION REQUEST received before REGISTRATION COMPLETE."
      }
    },
    {
      "id": "InformationElementsDiffer",
      "type": "condition",
      "properties": {
        "description": "Information elements in the redundant REGISTRATION REQUEST differ."
      }
    },
    {
      "id": "AbortPreviousRegistration",
      "type": "action",
      "properties": {
        "description": "AMF aborts the previously initiated registration procedure."
      }
    },
    {
      "id": "ProgressNewRegistration",
      "type": "action",
      "properties": {
        "description": "AMF progresses the new initial registration procedure."
      }
    },
    {
      "id": "InformationElementsSame",
      "type": "condition",
      "properties": {
        "description": "Information elements in the redundant REGISTRATION REQUEST do not differ."
      }
    },
    {
      "id": "RestartT3550",
      "type": "action",
      "properties": {
        "description": "AMF restarts T3550 without incrementing the retransmission counter."
      }
    },
    {
      "id": "RegistrationRequestRegisteredState",
      "type": "event",
      "properties": {
        "description": "REGISTRATION REQUEST received in 5GMM-REGISTERED state."
      }
    },
    {
      "id": "InitiateAuthentication",
      "type": "action",
      "properties": {
        "description": "Network may initiate 5GMM common procedures (Authentication)."
      }
    },
    {
      "id": "UEIsGenuine",
      "type": "condition",
      "properties": {
        "description": "UE is determined to be genuine and is already registered."
      }
    },
    {
      "id": "DeleteExistingContext",
      "type": "action",
      "properties": {
        "description": "Any existing 5GMM context is deleted."
      }
    },
    {
      "id": "ProgressNewRequest",
      "type": "action",
      "properties": {
        "description": "The new REGISTRATION REQUEST is progressed."
      }
    },
    {
      "id": "UENotGenuine",
      "type": "condition",
      "properties": {
        "description": "Network considers the UE not genuine based on the authentication procedure."
      }
    },
    {
      "id": "MaintainExistingContext",
      "type": "action",
      "properties": {
        "description": "The network shall maintain the 5GMM-context, if any, unchanged."
      }
    },
    {
      "id": "MobilityRegistrationRequest",
      "type": "event",
      "properties": {
        "description": "REGISTRATION REQUEST (Mobility or Periodic Registration Update) received before REGISTRATION COMPLETE."
      }
    },
    {
      "id": "StopT3550",
      "type": "action",
      "properties": {
        "description": "AMF stops T3550."
      }
    },
    {
      "id": "ProgressMobilityRegistration",
      "type": "action",
      "properties": {
        "description": "AMF progresses the mobility/periodic registration update procedure."
      }
    },
    {
      "id": "DeregistrationRequest",
      "type": "event",
      "properties": {
        "description": "DEREGISTRATION REQUEST received before REGISTRATION COMPLETE."
      }
    },
    {
      "id": "ProgressDeregistration",
      "type": "action",
      "properties": {
        "description": "AMF progresses the de-registration procedure."
      }
    },
    {
      "id": "InvalidUESecurityCapabilities",
      "type": "event",
      "properties": {
        "description": "Invalid or unacceptable UE security capabilities detected."
      }
    },
    {
      "id": "CAGRestrictions",
      "type": "event",
       "properties": {
        "description": "Initial registration request from a UE not supporting CAG is rejected due to CAG restrictions"
      }
    }
  ],
