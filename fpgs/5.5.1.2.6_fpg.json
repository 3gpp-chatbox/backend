      "type": "conditional",
      "properties": {}
    },
    {
        "from": "Equivalent_PLMN_SNPN",
        "to": "Initiate_New_Registration",
        "properties":{
          "description": "Initiate initial registration for emergency services",
          "condition_result": "true"
        }
    },
    {
        "from": "Not_Equivalent_PLMN_SNPN",
        "to": "Attempt_PLMN_SNPN_Selection",
        "properties":{
          "description": "Perform a PLMN/SNPN selection and initiate a new initial registration for emergency services",
          "condition_result": "true"
        }
    },
    {
      "from": "Registration_Reject_Received",
      "to": "Establish_Emergency_PDU_Session",
      "type": "conditional",
      "properties": {}
    },
    {
      "from": "Establish_Emergency_PDU_Session",
      "to": "Initial_Emergency_Request",
      "type": "conditional",
      "properties": {}
    },
    {
      "from": "Establish_Emergency_PDU_Session",
      "to": "Handover_Existing_PDN",
      "type": "conditional",
      "properties": {}
    },
     {
      "from": "Establish_Emergency_PDU_Session",
      "to": "Abnormal_Failure_Detected",
      "type": "conditional",
      "properties": {}
    },
    {
      "from": "Initial_Emergency_Request",
