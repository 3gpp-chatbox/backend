{
  "procedure_name": "Initial Registration Initiation",
  "description": "The UE in 5GMM-DEREGISTERED state initiates the registration procedure for initial registration by sending a REGISTRATION REQUEST message to the AMF under specific conditions.",
  "nodes": [
    {
      "id": "UE_5GMM_DEREGISTERED",
      "type": "state",
      "properties": {
        "state": "5GMM-DEREGISTERED"
      }
    },
    {
      "id": "Registration_Initiation_Conditions",
      "type": "state",
      "properties": {
        "conditions": [
          "Initial registration for 5GS services",
          "Initial registration for emergency services",
          "Initial registration for SMS over NAS",
          "UE moves from GERAN/UTRAN to NG-RAN coverage",
          "Initial registration for onboarding services in SNPN",
          "Initial registration for disaster roaming services",
          "Initial registration to come out of unavailability period and resume normal services"
        ]
      }
    },
    {
      "id": "Registration_Request_Sent",
      "type": "event",
      "properties": {
        "message_type": "REGISTRATION REQUEST"
      },
      "parameters": [
        "5GS mobile identity",
        "UE status",
        "Additional GUTI",
        "Last visited registered TAI",
        "5GS update type",
        "MICO indication",
        "T3324 IE",
        "Requested T3512 IE",
        "Requested DRX parameters IE",
        "Requested NB-N1 mode DRX parameters IE",
        "Requested extended DRX parameters IE",
        "LADN indication IE",
        "Requested NSSAI",
        "Network slicing indication IE",
        "5GMM capability IE",
        "S1 UE network capability IE",
        "Mobile station classmark 2 IE",
        "Supported codecs IE",
        "UE radio capability ID IE",
        "Payload container type IE",
        "NAS message container IE",
        "Additional information requested IE",
        "Requested WUS assistance information IE",
        "Requested PEIPS assistance information IE",
        "Service-level-AA container IE",
        "UE determined PLMN with disaster condition IE",
        "AUN3 indication IE",
        "N5GC indication IE"
      ]
    },
    {
      "id": "Timer_Started",
      "type": "action",
      "properties": {
        "timer": "T3510",
		"action":"start"
      }
    },
    {
      "id": "Timer_Stopped_T3502",
      "type": "action",
      "properties": {
        "timer": "T3502",
		"action":"stop"
      }
    },
    {
      "id": "Timer_Stopped_T3511",
      "type": "action",
      "properties": {
        "timer": "T3511",
		"action":"stop"
      }
    }
  ],
  "edges": [
    {
      "from": "UE_5GMM_DEREGISTERED",
      "to": "Registration_Initiation_Conditions",
      "action": "Check Registration Conditions",
      "properties": {}
    },
    {
      "from": "Registration_Initiation_Conditions",
      "to": "Registration_Request_Sent",
      "action": "Send REGISTRATION REQUEST to AMF",
      "properties": {
        "metadata": {
          "message_name": "REGISTRATION REQUEST"
        }
      }
    },
    {
      "from": "Registration_Request_Sent",
      "to": "Timer_Started",
      "action": "Start Timer",
      "properties": {
        "timer_name": "T3510"
      }
    },
    {
      "from": "Registration_Request_Sent",
      "to": "Timer_Stopped_T3502",
      "action": "Stop Timer if running",
      "properties": {
        "timer_name": "T3502",
        "condition": "if T3502 is running"
      }
    },
    {
      "from": "Registration_Request_Sent",
      "to": "Timer_Stopped_T3511",
      "action": "Stop Timer if running",
      "properties": {
        "timer_name": "T3511",
        "condition": "if T3511 is running"
      }
    }
  ]
}