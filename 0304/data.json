{
  "procedure_name": "Initial Registration Initiation",
  "description": "The UE in state 5GMM-DEREGISTERED initiates the registration procedure for initial registration by sending a REGISTRATION REQUEST message to the AMF under specific conditions.",
  "nodes": [
    {
      "id": "5GMM_DEREGISTERED",
      "type": "state",
      "properties": {
        "state": "5GMM-DEREGISTERED"
      }
    },
    {
      "id": "Initial_Registration_Initiation",
      "type": "action",
      "properties": {
        "action": "Initiate Registration Procedure"
      }
    },
    {
      "id": "REGISTRATION_REQUEST_Sent",
      "type": "event",
      "properties": {
        "message_type": "REGISTRATION REQUEST"
      }
    },
    {
      "id": "Timer_T3510_Started",
      "type": "action",
      "properties": {
        "action": "Start Timer T3510"
      }
    },
    {
      "id": "Timer_T3502_Stopped",
      "type": "action",
      "properties": {
        "action": "Stop Timer T3502",
        "conditional": "If Timer T3502 is running"
      }
    },
    {
      "id": "Timer_T3511_Stopped",
      "type": "action",
      "properties": {
        "action": "Stop Timer T3511",
        "conditional": "If Timer T3511 is running"
      }
    },
    {
      "id": "Handle_5GS_Mobile_Identity",
      "type": "action",
      "properties": {
        "action": "Handle 5GS Mobile Identity IE"
      }
    }
  ],
  "edges": [
    {
      "from": "5GMM_DEREGISTERED",
      "to": "Initial_Registration_Initiation",
      "action": "Determine Registration Reason",
      "properties": {
        "conditions": [
          "Initial registration for 5GS services",
          "Initial registration for emergency services",
          "Initial registration for SMS over NAS",
          "Mobility from GERAN/UTRAN to NG-RAN",
          "Initial registration for onboarding services in SNPN",
          "Initial registration for disaster roaming services",
          "Initial registration to come out of unavailability period"
        ]
      }
    },
    {
      "from": "Initial_Registration_Initiation",
      "to": "REGISTRATION_REQUEST_Sent",
      "action": "Send REGISTRATION REQUEST to AMF",
      "properties": {
        "parameters": [
          "5GS mobile identity IE (5G-GUTI, SUCI, PEI)",
          "UE status IE (EMM registration status)",
          "Last visited registered TAI",
          "5GS update type IE (SMS requested bit)",
          "MICO indication IE",
          "T3324 IE (Active time value)",
          "Requested T3512 IE",
          "Requested DRX parameters IE",
          "Requested NB-N1 mode DRX parameters IE",
          "Requested extended DRX parameters IE",
          "LADN indication IE",
          "Requested NSSAI IE",
          "5GMM capability IE",
          "S1 UE network capability IE",
          "Mobile station classmark 2 IE",
          "Supported codecs IE",
          "Payload container IE (UE STATE INDICATION message)",
          "Additional information requested IE",
          "Requested WUS assistance information IE",
          "Requested PEIPS assistance information IE",
          "Service-level-AA container IE",
          "UE determined PLMN with disaster condition IE",
          "N5GC indication IE",
          "AUN3 indication IE"
        ]
      }
    },
    {
      "from": "REGISTRATION_REQUEST_Sent",
      "to": "Timer_T3510_Started",
      "action": "Start Timer",
      "properties": {
        "timer": "T3510"
      }
    },
    {
      "from": "REGISTRATION_REQUEST_Sent",
      "to": "Timer_T3502_Stopped",
      "action": "Stop Timer (Conditional)",
      "properties": {
        "timer": "T3502",
        "condition": "If T3502 is running"
      }
    },
    {
      "from": "REGISTRATION_REQUEST_Sent",
      "to": "Timer_T3511_Stopped",
      "action": "Stop Timer (Conditional)",
      "properties": {
        "timer": "T3511",
        "condition": "If T3511 is running"
      }
    },
    {
      "from": "REGISTRATION_REQUEST_Sent",
      "to": "Handle_5GS_Mobile_Identity",
      "action": "Handle ID",
      "properties": {}
    }
  ]
}