{
  "procedure_name": "Initial Registration Initiation",
  "description": "The UE in state 5GMM-DEREGISTERED initiates the registration procedure for initial registration by sending a REGISTRATION REQUEST message to the AMF under specific conditions.",
  "nodes": [
    {
      "id": "5GMM_DEREGISTERED",
      "type": "state",
      "properties": {
        "state": "5GMM-DEREGISTERED"
      }
    },
    {
      "id": "Initial_Registration_Triggered",
      "type": "event",
      "properties": {
        "triggers": [
          "Initial registration for 5GS services",
          "Initial registration for emergency services",
          "Initial registration for SMS over NAS",
          "UE moves from GERAN/UTRAN to NG-RAN",
          "Initial registration for onboarding services in SNPN",
          "Initial registration for disaster roaming services",
          "Initial registration to come out of unavailability period and resume normal services"
        ]
      }
    },
    {
      "id": "UE_Initiates_Registration",
      "type": "action",
      "properties": {
        "action": "Sending REGISTRATION REQUEST message to AMF"
      }
    },
    {
      "id": "Timer_Started",
      "type": "action",
      "properties": {
        "action": "Starting timer T3510"
      }
    },
    {
      "id": "Timer_Stopped",
      "type": "action",
      "properties": {
        "action": "Stopping timer T3502 and/or T3511 if running"
      }
    },
    {
      "id": "5GS_Mobile_Identity_Handling",
      "type": "action",
      "properties": {
        "action": "Handles 5GS mobile identity IE based on available identities"
      }
    },
    {
      "id": "Additional_IE_Inclusion",
      "type": "action",
      "properties": {
        "action": "Includes additional IEs based on UE capabilities and network requirements"
      }
    },
    {
      "id": "SUCI_Timer_Handling",
      "type": "action",
      "properties": {
        "action": "Starts/uses timer T3519 if SUCI is included"
      }
    },
    {
      "id": "NAS_Security_Context",
      "type": "conditional",
      "properties": {
        "condition": "If UE has valid 5G NAS security context, includes NAS message container IE"
      }
    }
  ],
  "edges": [
    {
      "from": "5GMM_DEREGISTERED",
      "to": "Initial_Registration_Triggered",
      "action": "Detects trigger for initial registration",
      "properties": {}
    },
    {
      "from": "Initial_Registration_Triggered",
      "to": "UE_Initiates_Registration",
      "action": "Sends REGISTRATION REQUEST",
      "properties": {}
    },
    {
      "from": "UE_Initiates_Registration",
      "to": "Timer_Started",
      "action": "Starts Timer",
      "properties": {}
    },
    {
      "from": "UE_Initiates_Registration",
      "to": "Timer_Stopped",
      "action": "Stops Timers",
      "properties": {}
    },
    {
      "from": "UE_Initiates_Registration",
      "to": "5GS_Mobile_Identity_Handling",
      "action": "Handles Mobile Identity",
      "properties": {}
    },
    {
      "from": "5GS_Mobile_Identity_Handling",
      "to": "Additional_IE_Inclusion",
      "action": "Includes Additional IEs",
      "properties": {}
    },
    {
      "from": "Additional_IE_Inclusion",
      "to": "SUCI_Timer_Handling",
      "action": "Handles SUCI Timer",
      "properties": {}
    },
    {
      "from": "SUCI_Timer_Handling",
      "to": "NAS_Security_Context",
      "action": "Checks NAS Security Context",
      "properties": {}
    }
  ]
}