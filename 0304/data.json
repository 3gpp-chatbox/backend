{
  "procedure_name": "Initial Registration Initiation",
  "description": "The procedure initiated by the UE in the 5GMM-DEREGISTERED state to register for 5GS services, emergency services, SMS over NAS, or due to mobility events like moving from GERAN/UTRAN to NG-RAN, onboarding services in SNPN, disaster roaming services or to come out of unavailability period.",
  "nodes": [
    {
      "id": "UE_5GMM_DEREGISTERED",
      "type": "state",
      "properties": {
        "state": "5GMM-DEREGISTERED"
      }
    },
    {
      "id": "Registration_Initiation_Trigger",
      "type": "event",
      "properties": {
        "trigger_conditions": [
          "Initial registration for 5GS services",
          "Initial registration for emergency services",
          "Initial registration for SMS over NAS",
          "Mobility from GERAN/UTRAN to NG-RAN",
          "Initial registration for onboarding services in SNPN",
          "Initial registration for disaster roaming services",
		  "Initial registration to come out of unavailability period and resume normal services"
        ]
      }
    },
    {
      "id": "REGISTRATION_REQUEST_Sent",
      "type": "action",
      "properties": {
        "message_type": "REGISTRATION REQUEST"
      },
      "parameters": [
        "5GS mobile identity",
        "UE status",
        "Last visited registered TAI",
        "5GS update type",
        "MICO indication",
        "T3324 IE",
        "Requested T3512 IE",
        "Requested DRX parameters IE",
        "Requested NB-N1 mode DRX parameters IE",
        "Requested extended DRX parameters IE",
        "LADN indication IE",
        "Requested NSSAI",
        "Network slicing indication IE",
        "5GMM capability IE",
        "S1 UE network capability IE",
        "Mobile station classmark 2 IE",
        "Supported codecs IE",
        "UE policy container",
        "Additional information requested IE",
        "Requested WUS assistance information IE",
        "Requested PEIPS assistance information IE",
		"UE determined PLMN with disaster condition IE",
		"Service-level-AA container IE",
		"AUN3 indication IE",
		"N5GC indication IE"
      ]
    },
    {
      "id": "Timer_T3510_Started",
      "type": "action",
      "properties": {
        "timer": "T3510",
        "action": "start"
      }
    },
    {
      "id": "Timers_Stopped",
      "type": "action",
      "properties": {
        "timers": ["T3502", "T3511"],
        "action": "stop"
      }
    }
  ],
  "edges": [
    {
      "from": "UE_5GMM_DEREGISTERED",
      "to": "Registration_Initiation_Trigger",
      "action": "Detects_Registration_Need",
      "properties": {}
    },
    {
      "from": "Registration_Initiation_Trigger",
      "to": "REGISTRATION_REQUEST_Sent",
      "action": "Send_REGISTRATION_REQUEST",
      "properties": {
        "metadata": {
          "timestamp": "T1"
        }
      }
    },
    {
      "from": "REGISTRATION_REQUEST_Sent",
      "to": "Timer_T3510_Started",
      "action": "Start_Timer",
      "properties": {}
    },
    {
      "from": "REGISTRATION_REQUEST_Sent",
      "to": "Timers_Stopped",
      "action": "Stop_Timers",
      "properties": {}
    }
  ]
}