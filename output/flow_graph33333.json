{
    "procedureName": "Initial Registration Procedure",
    "nodes": [
        {
            "id": "5GMM-DEREGISTERED",
            "type": "State",
            "entity": "UE",
            "properties": {
                "state": "5GMM-DEREGISTERED",
                "description": "UE is in 5GMM-DEREGISTERED state, no 5GMM context established."
            },
            "metadata": {
                "document_id": "3GPP TS 24.501",
                "section_reference": "5.2.2"
            }
        },
        {
            "id": "Registration Request Sent",
            "type": "Event",
            "entity": "UE",
            "properties": {
                "eventType": "Registration Request Sent",
                "description": "UE sends a REGISTRATION REQUEST message to the AMF."
            },
            "metadata": {
                "document_id": "3GPP TS 24.501",
                "section_reference": "5.5.1.2.2"
            }
        },
        {
            "id": "5GMM-REGISTERED-INITIATED",
            "type": "State",
            "entity": "UE",
            "properties": {
                "state": "5GMM-REGISTERED-INITIATED",
                "description": "UE enters 5GMM-REGISTERED-INITIATED state, waiting for response from network."
            },
            "metadata": {
                "document_id": "3GPP TS 24.501",
                "section_reference": "5.1.3.2.1.2.3"
            }
        },
        {
            "id": "Registration Accepted",
            "type": "Event",
            "entity": "AMF",
            "properties": {
                "eventType": "Registration Accepted",
                "description": "Network accepts the registration request."
            },
            "metadata": {
                "document_id": "3GPP TS 24.501",
                "section_reference": "5.5.1.2.4"
            }
        },
        {
            "id": "5GMM-REGISTERED",
            "type": "State",
            "entity": "UE",
            "properties": {
                "state": "5GMM-REGISTERED",
                "description": "UE enters 5GMM-REGISTERED state, 5GMM context established."
            },
            "metadata": {
                "document_id": "3GPP TS 24.501",
                "section_reference": "5.1.3.2.1.2.4"
            }
        },
        {
            "id": "Registration Rejected",
            "type": "Event",
            "entity": "AMF",
            "properties": {
                "eventType": "Registration Rejected",
                "description": "Network rejects the registration request."
            },
            "metadata": {
                "document_id": "3GPP TS 24.501",
                "section_reference": "5.5.1.2.5"
            }
        }
    ],
    "edges": [
        {
            "id": "Initial Registration Request",
            "from": "5GMM-DEREGISTERED",
            "to": "Registration Request Sent",
            "type": "Action",
            "properties": {
                "messageType": "REGISTRATION REQUEST",
                "parameters": [
                    "5GS registration type IE (initial registration)",
                    "5GS mobile identity IE (SUCI or 5G-GUTI or PEI)",
                    "Requested NSSAI",
                    "UE status IE (if dual-registration mode)"
                ],
                "description": "UE initiates registration procedure by sending REGISTRATION REQUEST."
            }
        },
        {
            "id": "Start T3510",
            "from": "Registration Request Sent",
            "to": "5GMM-REGISTERED-INITIATED",
            "type": "Transition",
            "properties": {
                "description": "UE starts timer T3510 and enters 5GMM-REGISTERED-INITIATED state."
            }
        },
        {
            "id": "Registration Accept Received",
            "from": "5GMM-REGISTERED-INITIATED",
            "to": "Registration Accepted",
            "type": "Event",
            "properties": {
                "messageType": "REGISTRATION ACCEPT",
                "description": "AMF sends REGISTRATION ACCEPT message."
            }
        },
        {
            "id": "Registration Complete Sent",
            "from": "Registration Accepted",
            "to": "5GMM-REGISTERED",
            "type": "Action",
            "properties": {
                "messageType": "REGISTRATION COMPLETE",
                "parameters": [],
                "description": "UE sends REGISTRATION COMPLETE message."
            }
        },
        {
            "id": "Update Status to 5U1",
            "from": "5GMM-REGISTERED",
            "to": "5GMM-REGISTERED",
            "type": "Action",
            "properties": {
                "description": "UE sets 5GS update status to 5U1 UPDATED."
            }
        },
        {
            "id": "Registration Reject Received",
            "from": "5GMM-REGISTERED-INITIATED",
            "to": "Registration Rejected",
            "type": "Event",
            "properties": {
                "messageType": "REGISTRATION REJECT",
                "description": "AMF sends REGISTRATION REJECT message."
            }
        },
        {
            "id": "Back to 5GMM-DEREGISTERED",
            "from": "Registration Rejected",
            "to": "5GMM-DEREGISTERED",
            "type": "Transition",
            "properties": {
                "description": "UE returns to 5GMM-DEREGISTERED state."
            }
        }
    ]
}