            "properties": {
                "description": "UE receives REGISTRATION ACCEPT and transitions to 5GMM-REGISTERED."
            }
        },
        {
            "id": "AMF_Transition_to_Registered",
            "from": "AMF_Send_Registration_Accept",
            "to": "AMF_5GMM-REGISTERED",
            "type": "Transition",
            "properties": {
                "description": "AMF sends REGISTRATION ACCEPT and transitions to 5GMM-REGISTERED."
            }
        },
        {
            "id": "AMF_Reject_Registration",
            "from": "AMF_Receive_Registration_Request",
            "to": "AMF_Send_Registration_Reject",
            "type": "Action",
            "properties": {
                "messageType": "REGISTRATION REJECT",
                "parameters": [
                    "5GMM cause value",
                    "T3346 value (optional)"
                ],
                "conditions": [
                    "AMF cannot accept the registration request"
                ],
                "description": "AMF rejects the registration and sends REGISTRATION REJECT."
            }
        },
        {
            "id": "UE_Transition_to_Deregistered",
            "from": "UE_Receive_Registration_Reject",
            "to": "UE_5GMM-DEREGISTERED",
            "type": "Transition",
            "properties": {
                "description": "UE receives REGISTRATION REJECT and transitions to 5GMM-DEREGISTERED."
            }
        },
        {
            "id": "UE_Send_Registration_Complete_Message",
            "from": "UE_Receive_Registration_Accept",
            "to": "UE_Send_Registration_Complete",
            "type": "Action",
            "properties": {
                "messageType": "REGISTRATION COMPLETE",
                "description": "UE sends REGISTRATION COMPLETE message to AMF."
            }
        },
        {
            "id": "AMF_Receive_Registration_Complete_Message",
            "from": "AMF_Send_Registration_Accept",
            "to": "AMF_Receive_Registration_Complete",
            "type": "Action",
            "properties": {
                "messageType": "REGISTRATION COMPLETE",
                "description": "AMF receives REGISTRATION COMPLETE message from UE."
            }
