            "from": "UE_5GMM-DEREGISTERED",
            "to": "UE_Send_Registration_Request",
            "type": "Action",
            "properties": {
                "messageType": "REGISTRATION REQUEST",
                "parameters": [
                    "5GS registration type IE (initial registration)",
                    "5GS mobile identity IE (SUCI or PEI)",
                    "Requested NSSAI",
                    "5GMM capability IE",
                    "S1 UE network capability IE (if S1 mode supported)"
                ],
                "description": "UE initiates initial registration by sending REGISTRATION REQUEST."
            }
        },
        {
            "id": "AMF_Receive_Initial_Registration_Request",
            "from": "AMF_5GMM-DEREGISTERED",
            "to": "AMF_Receive_Registration_Request",
            "type": "Action",
            "properties": {
                "messageType": "REGISTRATION REQUEST",
                "description": "AMF receives REGISTRATION REQUEST from UE."
            }
        },
        {
            "id": "AMF_Accept_Registration",
            "from": "AMF_Receive_Registration_Request",
            "to": "AMF_Send_Registration_Accept",
            "type": "Action",
            "properties": {
                "messageType": "REGISTRATION ACCEPT",
                "parameters": [
                    "5G-GUTI",
                    "TAI list",
                    "Allowed NSSAI",
                    "5GS network feature support IE"
                ],
                "conditions": [
                    "AMF accepts the registration request"
                ],
                "description": "AMF accepts the registration and sends REGISTRATION ACCEPT."
            }
        },
        {
            "id": "UE_Transition_to_Registered",
            "from": "UE_Receive_Registration_Accept",
            "to": "UE_5GMM-REGISTERED",
